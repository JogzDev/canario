          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lidera os dois eixos: foi o que mais se moveu nos sinais externos e é o mais presente no painel (%2$@% do sortimento). Quando os dois andam juntos, lê-se como atributo estabelecido, e não como movimento novo."
