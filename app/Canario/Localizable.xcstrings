        }
      }
    },
    "This changes the whole app: screens, messages, attribute names, dates and prices. Headlines keep the language their source published in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This changes the whole app: screens, messages, attribute names, dates and prices. Headlines keep the language their source published in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto muda o app inteiro: telas, mensagens, nomes de atributo, datas e preços. As manchetes mantêm o idioma em que a fonte publicou."
          }
        }
      }
    },
    "This compares already collected market data. It is not a sales forecast and does not include your costs, timing or history.": {
