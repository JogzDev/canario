<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Manifesto de privacidade exigido pela Apple.

	  As três respostas abaixo são verdadeiras e verificáveis no código:

	  * A15 envia uma cópia reduzida, reamostrada e sem metadados da foto
	    escolhida para a Edge Function e para a OpenAI, somente após consentimento
	    explícito. Isso é Photos or Videos / App Functionality, não rastreamento
	    e não a anexa à identidade da A26.

	  * A26 oferece conta opcional. Quando usada, Supabase recebe identificador,
	    e-mail disponível e o conteúdo estruturado do Closet para sincronização.
	    A44 acrescenta somente a miniatura reduzida e sem metadados, em bucket
	    privado do usuário; nunca a foto original. Esses dados são vinculados à
	    identidade por necessidade funcional.

	  * Favoritos e a escolha explícita de ocultar similares também sincronizam.
	    A Apple classifica esse tipo de interação como Product Interaction.

	  * A rota visual retém por até sete dias somente um hash salgado e
	    irreversível da origem para limitar abuso. Como a Apple orienta declarar
	    IP armazenado conforme o uso, a ficha adota Device ID para esse hash;
	    ele não é ligado à conta e não é usado para rastreamento.

	  * NÃO rastreamos. Não há SDK de terceiro, nem analytics, nem identificador
	    de publicidade.

	  * NENHUMA API de "motivo obrigatório" é usada. Verificado por varredura:
	    o app não toca em UserDefaults, em data de arquivo, em espaço em disco
	    nem em tempo de atividade do sistema.

	  A entrada por imagem (§28) mantém OCR, cor e formulário locais como
	  fallback. Quando a análise remota está habilitada, o usuário escolhe a peça
	  visualmente e recebe um disclosure antes do envio. `store=false` impede
	  armazenamento como estado da Responses API, mas não elimina a possível
	  retenção de logs de monitoramento de abuso por até 30 dias.

	  Desde 07/08 (A12) o app PEDE duas permissões: câmera e leitura da
	  fototeca. Permissão de acesso e coleta continuam sendo coisas diferentes;
	  neste binário a foto entra no manifesto porque efetivamente cruza o
	  aparelho quando a pessoa confirma a análise visual.

	  Não pedimos escrita na fototeca (`NSPhotoLibraryAddUsageDescription` não
	  existe no Info.plist): o app não salva foto nenhuma, nem a que ele mesmo
	  tirou.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
