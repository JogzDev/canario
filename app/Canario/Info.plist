<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Escrito à mão (GENERATE_INFOPLIST_FILE = NO) porque precisamos das
	     variáveis do Supabase no fim deste arquivo, e a geração automática do
	     Xcode não aceita chaves próprias. Sem as chaves obrigatórias abaixo, o
	     simulador recusa a instalação com "Missing bundle ID". -->
	<key>CFBundleDevelopmentRegion</key>
	<string>pt_BR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Canário</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Conformidade de exportação. O app só faz HTTPS com o Supabase, que é
	     criptografia isenta pelas regras da Apple. Declarar aqui evita a
	     pergunta a cada envio ao TestFlight — e a resposta é a mesma sempre. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Lidos pelo Supabase.swift. Vêm do Config.xcconfig, que está no
	     .gitignore: nenhum valor real entra no repositório. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
</dict>
</plist>
