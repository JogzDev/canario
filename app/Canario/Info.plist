<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Escrito à mão (GENERATE_INFOPLIST_FILE = NO) porque precisamos das
	     variáveis do Supabase no fim deste arquivo, e a geração automática do
	     Xcode não aceita chaves próprias. Sem as chaves obrigatórias abaixo, o
	     simulador recusa a instalação com "Missing bundle ID".
	     O Xcode reordena e remove comentários ao salvar o projeto; se este
	     bloco sumir de novo, é isso, e não perda de chave. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>DataDrobe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>br.com.canario.ch3.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>datadrobe</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.693323431492-8qrjh4k10ss3obksbc2f2pcspbvglvlo</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>693323431492-8qrjh4k10ss3obksbc2f2pcspbvglvlo.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>693323431492-gkh4momvlddvc2nlaitegg6hbf2lk7a5.apps.googleusercontent.com</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Take a garment photo to suggest its attributes. Before cloud analysis, DataDrobe shows exactly what will be sent and asks for your permission.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a garment photo to suggest its attributes. Before cloud analysis, DataDrobe shows exactly what will be sent and asks for your permission.</string>
	<key>REMOTE_ANALYSIS_ENABLED</key>
	<string>$(REMOTE_ANALYSIS_ENABLED)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>AUTH_SUPABASE_URL</key>
	<string>$(AUTH_SUPABASE_URL)</string>
	<key>AUTH_SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(AUTH_SUPABASE_PUBLISHABLE_KEY)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
