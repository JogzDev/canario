<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Escrito à mão (GENERATE_INFOPLIST_FILE = NO) porque precisamos das
	     variáveis do Supabase no fim deste arquivo, e a geração automática do
	     Xcode não aceita chaves próprias. Sem as chaves obrigatórias abaixo, o
	     simulador recusa a instalação com "Missing bundle ID". -->
	<key>CFBundleDevelopmentRegion</key>
	<string>pt_BR</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Canário</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Conformidade de exportação. O app só faz HTTPS com o Supabase, que é
	     criptografia isenta pelas regras da Apple. Declarar aqui evita a
	     pergunta a cada envio ao TestFlight — e a resposta é a mesma sempre. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Câmera e fototeca (A12, decisão do JP em 07/08, desfazendo o corte do
	     A7). O texto que aparece no pedido de permissão diz o que o app faz com
	     a foto e o que ele NÃO faz — a revisão da App Store lê essa frase, e o
	     usuário também. Retenção zero continua valendo: a imagem é lida em
	     memória, os atributos saem dela no próprio aparelho e nada é copiado,
	     salvo ou enviado.

	     Só leitura da fototeca (NSPhotoLibraryUsageDescription), nunca escrita:
	     o app não salva foto nenhuma, então NSPhotoLibraryAddUsageDescription
	     não existe aqui de propósito. -->
	<key>NSCameraUsageDescription</key>
	<string>Para fotografar uma peça e reconhecer os atributos dela no próprio aparelho. A foto não é salva nem enviada.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Para ler uma foto que você escolher e reconhecer os atributos da peça no próprio aparelho. A foto não é salva nem enviada.</string>

	<!-- Lidos pelo Supabase.swift. Vêm do Config.xcconfig, que está no
	     .gitignore: nenhum valor real entra no repositório. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
</dict>
</plist>
